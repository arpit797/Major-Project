<% layout("/layouts/boilerplate")  -%>
<style>
#filters {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.8rem;
  padding: 1rem;
  align-items: center;
}

.filter {
  text-align: center;
  flex: 0 1 80px;       /* ← no growing, stays compact */
  max-width: 100px;
  opacity: 0.7;
  transition: all 0.3s ease;
  text-decoration: none;
  color: inherit;
}

.filter:hover, .filter.active-filter {
  opacity: 1;
  color: #fe424d;
  cursor: pointer;
  border-bottom: 2px solid #fe424d;
}

.filter p {
  font-size: 0.9rem;
  margin-top: 0.5rem;
}

.tax-toggle {
  display: flex;
  align-items: center;
  border: 1px solid black;
  border-radius: 1rem;
  padding: 0.5rem 1rem;
}

@media (max-width: 768px) {
  #filters {
    justify-content: space-around;
    gap: 0.5rem;
  }
  .filter {
    flex: 0 1 80px;
    max-width: 100px;
  }
}

@media (max-width: 480px) {
  #filters {
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .filter {
    width: 100%;
    max-width: 300px;
  }
  .tax-toggle {
    width: 100%;
    max-width: 300px;
    margin-left: 0;
    justify-content: center;
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.5rem;
    padding: 1rem;
  }
}
</style>
<body>
    
    <div id="filters">
      <a href="/listings" class="filter <%= !selectedCategory ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-border-all"></i></div>
          <p>All</p>
      </a>
      <a href="/listings?category=Trending" class="filter <%= selectedCategory === 'Trending' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
      </a>
      <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-bed"></i></div>
          <p>Rooms</p>
      </a>
      <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>Iconic Cities</p>
      </a>
      <a href="/listings?category=Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p>
      </a>
      <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active-filter' : '' %>">
          <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>Castles</p>
      </a>
      <a href="/listings?category=Amazing Pools" class="filter <%= selectedCategory === 'Amazing Pools' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-person-swimming"></i></div>
          <p>Amazing Pools</p>
      </a>
      <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-tent-arrow-left-right"></i></div>
          <p>Camping</p>
      </a>
      <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-building-wheat"></i></div>
          <p>Farms</p>
      </a>
      <a href="/listings?category=Arctic" class="filter <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
          <div><i class="fa-solid fa-igloo"></i></div>
          <p>Arctic</p>
      </a>
       <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
             <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
         </div>
      </div>
      
    </div>

    <% if (allListings.length === 0) { %>
      <div class="col-12 text-center my-5">
        <h4>No listings found <%= selectedCategory ? `in category "${selectedCategory}"` : (searchQuery ? `for "${searchQuery}"` : '') %></h4>
        <p class="text-muted">Try selecting a different filter or clear your search.</p>
        <a href="/listings" class="btn btn-outline-danger mt-2">View All Listings</a>
      </div>
    <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for(let listing of allListings) { %>
         <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card" >
  <img 
  src="<%= typeof listing.image === 'object' && listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' ? listing.image : 'https://images.unsplash.com/photo-1625244724120-1fd1d34d00f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60') %>" class="card-img-top" alt="listing_image" style="height:20rem"/>

  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
     <b> <%= listing.title %> </b><br>
      ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %>/night 
      <i class="tax-info" style="display: none;">&nbsp; &nbsp;+18% GST</i>
    </p>
  </div>
</div>
</a>
<% } %>
    </div>
    <% } %>  
</body>

<script>
  let taxSwitch=document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
    let taxInfo =document.getElementsByClassName("tax-info");
    for(let info of taxInfo){
      info.style.display=taxSwitch.checked ?"inline":"none";
    }
  });
</script>